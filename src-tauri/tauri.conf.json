{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NSE Market Suite",
  "version": "1.0.0",
  "identifier": "com.nsemarket.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NSE Market Data Automation & Dashboard",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/fastapi-backend"
    ]
  },
  "plugins": {
    "dialog": {},
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
