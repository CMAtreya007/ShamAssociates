# ==============================================================================
# NSE Market Data Automation & Dashboard - Environment Configuration
# ==============================================================================

# Server Settings
HOST=127.0.0.1
PORT=8756
DEBUG=True

# Database Configuration (Async SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/nse_market.db

# Storage directory for Excel exports
EXPORT_DIR=./exports

# Scheduler Settings (IST - Indian Standard Time)
# Runs post-market-close sync at 16:30, 17:00, 18:00 on weekdays (Mon-Fri)
SCHEDULE_CRON_TIMES=16:30,17:00,18:00

# Fallback / Optional Future External API Keys (Leave blank if not using third-party providers)
ALPHA_VANTAGE_API_KEY=
UPSTOX_API_KEY=
FINANCIAL_MODELING_PREP_KEY=
